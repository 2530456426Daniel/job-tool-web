{
  // Node 侧脚本（vite.config.ts）的类型检查配置。
  // @vue/tsconfig 提供 tsconfig.json（基础）/ dom.json / lib.json，
  // 其基础配置已包含 module: ESNext + moduleResolution: bundler。
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": ["vite.config.ts"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "types": ["node"]
  }
}
